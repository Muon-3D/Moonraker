[server]
# KAN-68: bind loopback only. Nginx on :80 is the single network front door and
# the only place client authentication is enforced (see fluidd.nginx.template).
# Binding 0.0.0.0 here would put an unauthenticated operator API for a machine
# with 200 C+ heaters and moving axes on the customer LAN.
host: 127.0.0.1
port: 7125
max_upload_size: 1024
klippy_uds_address: ${PRINTER_ADMIN_DIR}/comms/klippy.sock

[file_manager]
# KAN-108 note, deliberately not a setting. `enable_config_write_access:
# False` closes the LAN write path into the calibration root, and an
# earlier revision of this branch set it. It is not set here: the flag is
# a blunt instrument that also removes the legitimate ability to write
# calibration results through the file API, which Fluidd's config editor
# and any future calibration UI depend on -- and the connectivity work
# already carries a narrower fix, an allowlist on the write path that
# keeps the useful half. Two mechanisms for one hole, one of which breaks
# a shipped feature, is worse than the one that does not.
#
# The load-path half of KAN-108 does live in this branch, in Klipper's
# klippy/configfile.py: the overlay is refused at load however it reached
# the disk, which is the part a write-path allowlist cannot cover on its
# own, and which that work explicitly called out as still missing.
enable_object_processing: True
check_klipper_config_path: False
config_defaults_path: ${KLIPPER_DEFAULT_CONFIGS_DIR}
config_custom_config_path: /home/printer_data/devmode_custom_config

[authorization]
# KAN-68 / KAN-191.
#
# How trusted_clients actually behaves here, because it is not obvious and
# getting it wrong is how this regresses:
#
# MoonrakerApp builds its HTTPServer with xheaders=True
# (components/application.py:315), so Tornado overwrites request.remote_ip from
# X-Real-Ip / X-Forwarded-For before authorization.py:861 reads it. The nginx
# proxy hop is therefore TRANSPARENT -- Moonraker sees the real client address,
# not 127.0.0.1. Both vhosts set `proxy_set_header X-Real-IP $remote_addr`,
# which replaces any value the caller supplied, so the address cannot be forged
# through nginx.
#
# The consequence is what we want: with only loopback trusted,
#   - MuonUI on the panel reaches nginx :100 over localhost   -> 127.0.0.1 -> trusted
#   - muon-link terminates remote sessions onto 127.0.0.1:80  -> 127.0.0.1 -> trusted
#   - a browser on the LAN reaching :80                       -> its own IP  -> 401
# so an unpaired device on the same network can read nothing and control
# nothing, which is the Tier 1 acceptance criterion.
#
# Because the proxy hop is transparent, a LAN client that authenticates must do
# so with a credential rather than by address. Fluidd over the LAN therefore
# depends on the paired-client credential (KAN-190/KAN-191); until that lands,
# LAN Fluidd gets 401 by design.
#
# NOTE on force_logins: authorization.py:883 only honours it when
# len(self.users) > 1, and _API_KEY_USER_ always occupies one slot, so on a
# device with no human user created this setting is inert on its own. It is set
# as defence in depth, not as the control.
force_logins: true
# WEB-8. The `*://*` development entry that used to end this list is deleted,
# not commented: a commented-out wildcard is one uncomment away from handing
# every page on the internet a driveable printer, and it reads as a suggestion.
#
# `*://my.fluidd.xyz` and `*://*.lan` go with it. We ship Fluidd in the image,
# so trusting the hosted copy buys a customer nothing while letting any page
# served from that domain drive the machine; and `.lan` is a suffix no Muon
# address uses (WEB-1: `muon3d.local` and `app.muon3d.com`, nothing else).
#
# The two localhost entries are not wildcards and are not reachable from the
# network -- a page can only be served from them by a process already on the
# device -- so they stay: :100 is the panel's own vhost, :5173 the MuonUI dev
# server.
cors_domains:
    *://*.local
    *://app.muon3d.com
    *://localhost:100 #Access for MuonUI Local Service
    *://localhost:5173 #Acces for MuonUI Dev Server
trusted_clients:
    127.0.0.0/8
    ::1/128

[octoprint_compat]

[zeroconf]
octoprint_discovery: True
octoprint_model_name: Muon M1
octoprint_addr_pref: hostname

[history]

[announcements]
subscriptions:
    fluidd
    #todo add ciruclar screen

[gcode_preprocessor]
# KAN-193 / invariant I5.  This section is a safety control, not a feature: if
# it is absent the component never loads, and both enforcement points in
# file_manager.py and klippy_apis.py degrade to a logged error while G-code
# reaches Klipper without ever passing avoid_excluded_zone.
# tests/test_gcode_guard.py asserts the section is present and names a binary.
binary: ${AVOID_EXCLUDED_ZONE_BINARY}
# Bound on a single postprocessor run.  Before KAN-193 there was no timeout at
# all, so a postprocessor that hung hung the upload -- and, via start_print, the
# print request -- indefinitely.
timeout: 120

[aux_api_proxy]

# KAN-162: start the bed ramp when a job is queued instead of at the top
# of PRINT_START.  This turns on the 170W bed heater with no human input,
# so the component itself defaults to disabled -- enabling it is an
# explicit, per-model decision that has to be visible right here.
[preheat_on_queue]
enable: True
# Cancel the preheat if no print has started within this many seconds.
# Deliberately below klipper's [idle_timeout] default of 600s (no
# [idle_timeout] section is defined for the M1, so the default applies)
# so that this component gets to issue a targeted "M140 S0" before
# klipper's blunt TURN_OFF_HEATERS/M84 backstop fires.
timeout: 480
# first_layer_bed_temp values outside this range are treated as
# implausible and ignored.  The bed is never preheated on a guess.
min_bed_temp: 40
max_bed_temp: 120

[update_manager]
refresh_interval: 168
enable_auto_refresh: True
enable_system_updates: False
enable_moonraker_updates: False
enable_klipper_updates: False

[update_manager MuonOS]
type: ota
